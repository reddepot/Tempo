# --- Canaux (renseigner au moins un) ---
# ntfy : installer l'appli ntfy sur le téléphone et s'abonner au même sujet
NTFY_TOPIC=tempo-choisir-un-nom-long-et-secret
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Telegram : bot créé via @BotFather, chat_id via @userinfobot
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# Signal : via le conteneur signal-api (voir docker-compose.yml)
# SIGNAL_API_URL=http://signal-api:8080
# SIGNAL_NUMBER=+33612345678
# SIGNAL_RECIPIENTS=+33612345678

# --- Horaires (heure de Paris) ---
CHECK_FROM=10:45
CHECK_UNTIL=20:00
CHECK_EVERY_MIN=30
# Rappel le matin de la couleur du jour (vide = désactivé)
MORNING_AT=06:30
# Ne notifier que certaines couleurs (vide = toutes), ex. BLANC,ROUGE
NOTIFY_ONLY=
